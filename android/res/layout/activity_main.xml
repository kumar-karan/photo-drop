<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- Top Status Band -->
    <dev.photodrop.app.StatusStripView
        android:id="@+id/statusStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Main Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- 1. Orb Stage (STOPPED / STARTING) -->
            <LinearLayout
                android:id="@+id/orbStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="36dp"
                android:paddingBottom="36dp">

                <dev.photodrop.app.OrbView
                    android:id="@+id/orbView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvOrbCaption"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="One tap and this becomes a link you can hand to a friend."
                    android:textColor="@color/text_faint"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- 2. Studio Receiver Dashboard (ONLINE) -->
            <LinearLayout
                android:id="@+id/handoffCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header Title Row: "DropServer" + Subtitle + Power/Settings Icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DropServer"
                            android:textColor="@color/text_main"
                            android:textSize="24sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvDropDomain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="trycloudflare.com"
                            android:textColor="@color/text_faint"
                            android:textSize="11.5sp"/>
                    </LinearLayout>

                    <!-- Status Pill: "200 OK" / "LIVE" -->
                    <TextView
                        android:id="@+id/tvDockedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_live"
                        android:paddingLeft="12dp"
                        android:paddingTop="5dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="5dp"
                        android:text="200 OK"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- URL Endpoint Pill Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_handoff"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingTop="10dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/pill_success"/>

                    <TextView
                        android:id="@+id/tvDropUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="GET /d/.../sync/status"
                        android:textColor="@color/mono_text"
                        android:textSize="11.5sp"/>

                    <Button
                        android:id="@+id/btnFlipHost"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/btn_tonal"
                        android:text="⇄"
                        android:textColor="@color/text_main"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- 3 Pastel Action Pills: In / Free / QR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Pill 1: Total In -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_mint"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPillTotalIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 In"
                            android:textColor="@color/mint_text"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Pill 2: Free Space -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_danger"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPillFreeSpace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="105 GB Free"
                            android:textColor="#8C1D18"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Pill 3: QR Toggle -->
                    <LinearLayout
                        android:id="@+id/btnToggleQr"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tonal"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QR Code"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- CENTER MINT STORAGE FOLDERS CONTAINER (Exact Match to Reference) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_mint"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Samsung Storage Folders ↑"
                            android:textColor="@color/mint_text"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="•••"
                            android:textColor="@color/mint_text"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Row 1: DCIM / PhotoDrop (Camera Roll Sync) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_handoff"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/card_mint"
                            android:gravity="center"
                            android:text="📷"
                            android:textSize="16sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DCIM / PhotoDrop"
                                android:textColor="@color/text_main"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvFolderPhotosMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Direct inbox • Google Photos backup"
                                android:textColor="@color/text_faint"
                                android:textSize="11sp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_live"
                            android:paddingLeft="8dp"
                            android:paddingTop="3dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="3dp"
                            android:text="ACTIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="9.5sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Row 2: High-Watermark Ledger -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/card_handoff"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/pill_warning"
                            android:gravity="center"
                            android:text="⚡"
                            android:textSize="16sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="sync_ledger.json"
                                android:textColor="@color/text_main"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvLedgerSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="Watermark: Live &amp; Ready"
                                android:textColor="@color/text_faint"
                                android:textSize="10.5sp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIFF"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- QR CODE POPUP CARD (Centered) -->
                <LinearLayout
                    android:id="@+id/qrContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_handoff"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="HOLD THIS UP TO YOUR FRIEND"
                        android:textColor="@color/text_faint"
                        android:textSize="9.5sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/imgQr"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="10dp"
                        android:background="#FFFFFF"
                        android:contentDescription="QR code for photo drop link"
                        android:padding="6dp"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:id="@+id/tvDropHint"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="They scan, pick photos, watch them upload. Nothing is installed on their phone."
                        android:textColor="@color/text_faint"
                        android:textSize="11.5sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- 3. Storage Alert Card -->
            <LinearLayout
                android:id="@+id/alertCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/card_alert"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free some space first"
                    android:textColor="#8C1D18"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAlertDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Uploads are paused at 2.0 GB free to keep your phone healthy. Free some storage to resume."
                    android:textColor="#8C1D18"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- 4. Termux Error Card -->
            <LinearLayout
                android:id="@+id/permCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Can't reach Termux"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Grant permission to run commands in Termux, or ensure Termux is installed and running."
                    android:textColor="#C7CCD1"
                    android:textSize="13sp"/>

                <Button
                    android:id="@+id/btnFixPerm"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_primary"
                    android:text="Grant Permission"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- ZONE 3: Pinned Bottom Sheet -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <!-- Grab Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/grab_handle"/>

        <!-- Live Controls (URL + Copy Link) -->
        <LinearLayout
            android:id="@+id/liveControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- URL snippet row with Copy Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSheetUrl"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_low"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:singleLine="true"
                    android:text="https://.../d/..."
                    android:textColor="@color/mono_text"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_primary"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/stroke_soft"/>
        </LinearLayout>

        <!-- Storage & Session Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- free"
                android:textColor="@color/text_main"
                android:textSize="13.5sp"
                android:textStyle="bold"/>

            <dev.photodrop.app.StorageBarView
                android:id="@+id/storageBar"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_neutral"
                android:paddingLeft="8dp"
                android:paddingTop="3dp"
                android:paddingRight="8dp"
                android:paddingBottom="3dp"
                android:text="0 SESSIONS"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Live In-Flight Transfer Card -->
        <LinearLayout
            android:id="@+id/liveTransferBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_low"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTransferBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_warning"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="● UPLOADING"
                    android:textColor="#8C1D18"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTransferSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Receiving photos..."
                    android:textColor="@color/text_main"
                    android:textSize="12.5sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details ›"
                    android:textColor="@color/text_faint"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTransferFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:text="IMG_4821.HEIC"
                android:textColor="@color/text_faint"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <!-- Stop Server Button -->
        <LinearLayout
            android:id="@+id/liveStopSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_stop"
                android:text="Stop server"
                android:textAllCaps="false"
                android:textColor="#B3261E"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Owner Dashboard Action Button -->
        <Button
            android:id="@+id/btnOwner"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_text_only"
            android:gravity="center"
            android:text="Open live dashboard"
            android:textAllCaps="false"
            android:textColor="@color/text_faint"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
