<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- 1. Top Status Strip View for System Diagnostics -->
    <dev.photodrop.app.StatusStripView
        android:id="@+id/statusStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Main Content Area with Natural Overscroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="18dp"
            android:paddingTop="12dp"
            android:paddingRight="18dp"
            android:paddingBottom="16dp">

            <!-- Orb Stage (STOPPED / STARTING) -->
            <LinearLayout
                android:id="@+id/orbStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="36dp"
                android:paddingBottom="36dp">

                <dev.photodrop.app.OrbView
                    android:id="@+id/orbView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvOrbCaption"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="One tap and this becomes a link you can hand to a friend."
                    android:textColor="@color/text_faint"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Studio Receiver Dashboard (ONLINE) -->
            <LinearLayout
                android:id="@+id/handoffCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- DropServer Header: Title, Domain & Live Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DropServer"
                            android:textColor="@color/text_main"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDropDomain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="trycloudflare.com"
                            android:textColor="@color/text_faint"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Status Pill: "200 OK" / "LIVE" -->
                    <TextView
                        android:id="@+id/tvDockedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_live"
                        android:paddingLeft="12dp"
                        android:paddingTop="5dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="5dp"
                        android:text="200 OK"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Endpoint Pill Bar: Clean Copyable URL + Fast Protocol Switch (48x48dp hit area) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_handoff"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingTop="6dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/pill_success" />

                    <TextView
                        android:id="@+id/tvDropUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="GET /d/.../sync/status"
                        android:textColor="@color/mono_text"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnFlipHost"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:background="@drawable/btn_tonal"
                        android:text="⇄"
                        android:textColor="@color/text_main"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 3 Studio Pastel Action Chips: In / Free / QR Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Chip 1: Total In (Mint) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_mint"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp">

                        <TextView
                            android:id="@+id/tvPillTotalIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 In"
                            android:textColor="@color/mint_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Chip 2: Free Space (Soft Pink/Red) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_danger"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp">

                        <TextView
                            android:id="@+id/tvPillFreeSpace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="105 GB Free"
                            android:textColor="#8C1D18"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Chip 3: QR Code Toggle (Min Touch Target >= 48dp) -->
                    <LinearLayout
                        android:id="@+id/btnToggleQr"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_tonal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QR Code"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Storage Folders Card (@drawable/card_mint: mint green #DFF2E6 with 22dp radius) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/card_mint"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Samsung Storage Folders ↑"
                            android:textColor="@color/mint_text"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="•••"
                            android:textColor="@color/mint_text"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 1: DCIM / PhotoDrop -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_handoff"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/card_mint"
                            android:gravity="center"
                            android:text="📁"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DCIM / PhotoDrop"
                                android:textColor="@color/text_main"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFolderPhotosMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Direct inbox • Google Photos backup"
                                android:textColor="@color/text_faint"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_live"
                            android:paddingLeft="9dp"
                            android:paddingTop="4dp"
                            android:paddingRight="9dp"
                            android:paddingBottom="4dp"
                            android:text="ACTIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 2: sync_ledger.json -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_handoff"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/pill_warning"
                            android:gravity="center"
                            android:text="⚡"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="sync_ledger.json"
                                android:textColor="@color/text_main"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLedgerSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="High-watermark auto resume active"
                                android:textColor="@color/text_faint"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIFF"
                            android:textColor="@color/primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Clean QR Handoff Card (@drawable/card_handoff: white, 24dp radius, #E2E5E8 stroke) -->
                <LinearLayout
                    android:id="@+id/qrContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/card_handoff"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="HOLD THIS UP TO YOUR FRIEND"
                        android:textColor="@color/text_faint"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgQr"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginTop="14dp"
                        android:background="#FFFFFF"
                        android:contentDescription="QR code for photo drop link"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvDropHint"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="They scan, pick photos, watch them upload. Nothing is installed on their phone."
                        android:textColor="@color/text_faint"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/card_low"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋  Tap card to copy link"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Storage Alert Card -->
            <LinearLayout
                android:id="@+id/alertCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/card_alert"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free some space first"
                    android:textColor="#8C1D18"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlertDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Uploads are paused at 2.0 GB free to keep your phone healthy. Free some storage to resume."
                    android:textColor="#8C1D18"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Termux Error Card -->
            <LinearLayout
                android:id="@+id/permCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Can't reach Termux"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Grant permission to run commands in Termux, or ensure Termux is installed and running."
                    android:textColor="#C7CCD1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnFixPerm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_primary"
                    android:text="Grant Permission"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- 7. Elevated Bottom Sheet: Storage bar, Sessions badge, Live in-flight progress & Floating Black Pill Bar -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="12dp"
        android:paddingRight="18dp"
        android:paddingBottom="16dp">

        <!-- Storage & Sessions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- free"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:textStyle="bold" />

            <dev.photodrop.app.StorageBarView
                android:id="@+id/storageBar"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_neutral"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="0 SESSIONS"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live In-Flight Transfer Card (Visible when uploading or recent) -->
        <LinearLayout
            android:id="@+id/liveTransferBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_low"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTransferBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_warning"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="● UPLOADING"
                    android:textColor="#8C1D18"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransferSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Receiving photos..."
                    android:textColor="@color/text_main"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details ›"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTransferFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="IMG_4821.HEIC"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <!-- In-Flight Progress Bar -->
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/electric_blue" />
        </LinearLayout>

        <!-- Live Controls (Hidden URL Anchor + Action Buttons) -->
        <LinearLayout
            android:id="@+id/liveControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSheetUrl"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="https://..."
                android:visibility="gone" />

            <!-- Floating Black Pill Bar (#141519) with 3 action pills (Touch targets >= 48dp) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/pillnav_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <!-- 1. Copy Link Action Pill (#1E50FF) -->
                <Button
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="Copy Link"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 2. Dashboard Action Pill -->
                <Button
                    android:id="@+id/btnOwner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_tonal"
                    android:text="Dashboard"
                    android:textAllCaps="false"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 3. Stop Server Action Pill -->
                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/btn_stop"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="Stop"
                    android:textAllCaps="false"
                    android:textColor="#B3261E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dummy container for liveStopSection reference in code -->
        <LinearLayout
            android:id="@+id/liveStopSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
